// ALL IMPORTS MUST BE AT THE VERY TOP
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        // --- 1. HELLO WORLD ---
        System.out.println("Hello World!");

        // --- 2. DECLARING VARIABLES ---
        int age = 20; 
        double price = 40.55; 
        float weight = 85.9f;
        char grade = 'A'; 
        boolean isStudent = true; 
        String name = "Tobias"; 

        // --- 3. OUTPUT VARIABLES ---
        System.out.println("Name:" + name);
        System.out.println("Age:" + age);
        System.out.println("Price:" + price);
        System.out.println("Weight:" + weight);
        System.out.println("Grade:" + grade);
        System.out.println("Is Student?" + isStudent);

        // --- 4. GETTING INPUT USING SCANNER ---
        System.out.print("\nEnter your City: ");
        String userCity = scanner.next(); 
        System.out.println("You live in:" + userCity);

        scanner.nextLine(); // clears leftover newline
        System.out.print("Enter a sentence about yourself: ");
        String fullSentence = scanner.nextLine(); 
        System.out.println("You said: " + fullSentence);

        // --- 5. OPERATIONS AND EXPRESSIONS ---
        int a = 10, b = 3;
        System.out.println("a + b = " + (a + b));

        b = 28; 
        System.out.println("a - b = " + (a - b));

        a = 28; b = 10;
        System.out.println("a * b = " + (a * b));
        System.out.println("a / b = " + (a / b));
        System.out.println("a % b = " + (a % b));

        double x = 10, y = 3;
        System.out.println("x / y = " + (x / y)); 

        System.out.println("\na == b: " + (a == b)); 
        System.out.println("\na != b: " + (a != b)); 
        System.out.println("\na > b: " + (a > b)); 
        System.out.println("\na < b: " + (a < b)); 

        boolean p = true, q = false;
        System.out.println("\np && q: " + (p && q)); 
        System.out.println("p || q: " + (p || q)); 
        System.out.println("!p: " + (!p));

        int scoreValue = 50;
        scoreValue += 10;
        System.out.println("\nscore after += 10: " + scoreValue); 
        scoreValue *= 2;
        System.out.println("score after *=2: " + scoreValue); 

        int counter = 5; 
        System.out.println("\ncounter++ (post):  " + counter++); 
        System.out.println("counter now: " + counter); 
        System.out.println("++counter (pre): " + ++counter); 

        // --- 6. CONTROL FLOW (IF / ELSE IF) ---
        System.out.print("\nEnter your exam score: ");
        int score = scanner.nextInt();

        if (score >= 90) {
            System.out.println("Grade: A");
        } else if (score >= 80) {
            System.out.println("Grade: B");
        } else if (score >= 75) {
            System.out.println("Grade: C");
        } else {
            System.out.println("Grade: F");
        }

        // --- 7. SWITCH CASE ---
        System.out.print("\nEnter a day number (1-7): ");
        int day = scanner.nextInt();

        switch (day) {
            case 1: System.out.println("Monday"); break;
            case 2: System.out.println("Tuesday"); break;
            case 3: System.out.println("Wednesday"); break;
            case 4: System.out.println("Thursday"); break;
            case 5: System.out.println("Friday"); break;
            case 6: System.out.println("Saturday"); break;
            case 7: System.out.println("Sunday"); break;
            default: System.out.println("Invalid day"); break;
        }

        // --- 8. FOR LOOP ---
        System.out.println("\nCounting 1 to 5 with a for loop:");
        for (int i = 1; i <= 5; i++) {
            System.out.println(i);
        }
        
        scanner.close();
    } // End of main method
} // End of Main class

